<Page
    x:Class="addOneSecond.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:addOneSecond"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <SplitView Name="mainSplitView" DisplayMode="Overlay" OpenPaneLength="320">
        <SplitView.Pane>
            <ScrollViewer Background="#FFD9D9D9">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="设置" HorizontalAlignment="Center" FontSize="22" Margin="5"/>

                    <ToggleSwitch Name="isfullScreen"
                                  OffContent="全屏已关闭"
                                  OnContent="全屏已开启"
                                  Margin="5"
                                  Toggled="isfullScreen_Toggled"/>

                    <ToggleSwitch Name="isTileFresh"
                                  OffContent="动态磁贴已关闭"
                                  OnContent="动态磁贴已开启"
                                  Margin="5"
                                  Toggled="isTileFresh_Toggled"/>

                    <TextBlock Text="磁贴刷新间隔：" FontSize="16" Margin="5,4,0,0"/>
                    <ComboBox Name="tileIntervalCombo"
                              Margin="5,0,5,8"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="tileIntervalCombo_SelectionChanged">
                        <ComboBoxItem Content="30 分钟" Tag="HalfHour"/>
                        <ComboBoxItem Content="1 小时" Tag="Hour"/>
                        <ComboBoxItem Content="6 小时" Tag="SixHours"/>
                        <ComboBoxItem Content="12 小时" Tag="TwelveHours"/>
                        <ComboBoxItem Content="24 小时" Tag="Daily"/>
                    </ComboBox>

                    <ToggleSwitch Name="isWorkerFirst"
                                  OffContent="磁贴源：Pages 优先"
                                  OnContent="磁贴源：Worker 优先"
                                  Margin="5"
                                  Toggled="isWorkerFirst_Toggled"/>

                    <ToggleSwitch Name="isDisplayRequest"
                                  OffContent="屏幕常亮已关闭"
                                  OnContent="屏幕常亮已开启"
                                  Margin="5"
                                  Toggled="isDisplayRequest_Toggled"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="背景颜色：" FontSize="22" Margin="5"/>
                        <Button Name="ApplyBackGroungColor" Content="保存设置" Margin="5" Click="ApplyBackGroungColor_Click"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="红：" FontSize="20" Margin="5"/>
                        <Slider Name="BackGroundColorRedSlider"
                                Grid.Column="1"
                                Maximum="255"
                                Width="220"
                                Margin="2,0,20,0"
                                ValueChanged="BackGroundColorRedSlider_ValueChanged"/>
                        <TextBlock Text="绿：" FontSize="20" Margin="5" Grid.Row="1"/>
                        <Slider Name="BackGroundColorGreenSlider"
                                Grid.Column="1"
                                Grid.Row="1"
                                Maximum="255"
                                Width="220"
                                Margin="2,0,20,0"
                                ValueChanged="BackGroundColorGreenSlider_ValueChanged"/>
                        <TextBlock Text="蓝：" FontSize="20" Margin="5" Grid.Row="2"/>
                        <Slider Name="BackGroundColorBlueSlider"
                                Grid.Column="1"
                                Grid.Row="2"
                                Maximum="255"
                                Width="220"
                                Margin="2,0,20,0"
                                ValueChanged="BackGroundColorBlueSlider_ValueChanged"/>
                        <TextBlock Text="透：" FontSize="20" Margin="5" Grid.Row="3"/>
                        <Slider Name="BackGroundAcrylicBlueSlider"
                                Grid.Column="1"
                                Grid.Row="3"
                                Maximum="100"
                                Width="220"
                                Margin="2,0,20,0"
                                Value="10"
                                ValueChanged="BackGroundAcrylicBlueSlider_ValueChanged"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="字体颜色：" FontSize="22" Margin="5"/>
                        <Button Name="ApplyFontColor" Content="保存设置" Margin="5" Click="ApplyFontColor_Click"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="红：" FontSize="20" Margin="5"/>
                        <Slider Name="FontColorRedSlider"
                                Grid.Column="1"
                                Maximum="255"
                                Width="220"
                                Margin="2,0,20,0"
                                ValueChanged="FontColorRedSlider_ValueChanged"/>
                        <TextBlock Text="绿：" FontSize="20" Margin="5" Grid.Row="1"/>
                        <Slider Name="FontColorGreenSlider"
                                Grid.Column="1"
                                Grid.Row="1"
                                Maximum="255"
                                Width="220"
                                Margin="2,0,20,0"
                                ValueChanged="FontColorGreenSlider_ValueChanged"/>
                        <TextBlock Text="蓝：" FontSize="20" Margin="5" Grid.Row="2"/>
                        <Slider Name="FontColorBlueSlider"
                                Grid.Column="1"
                                Grid.Row="2"
                                Maximum="255"
                                Width="220"
                                Margin="2,0,20,0"
                                ValueChanged="FontColorBlueSlider_ValueChanged"/>
                    </Grid>

                    <TextBlock Text="本项目地址：" FontSize="16" Margin="5,12,0,0"/>
                    <TextBlock Text="https://github.com/bzhcyy/add-one-second-UWP"
                               IsTextSelectionEnabled="True"
                               FontSize="15"
                               Margin="5,0,20,10"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid Name="mainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Name="secondTotalShow"
                           Text="每日一言"
                           Grid.Row="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="20"
                           Margin="0,12,0,0"/>

                <TextBlock Name="realTime"
                           Text="你的实际时间（加载中。。。）"
                           Grid.Row="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontSize="12"
                           Margin="12,20,0,0"/>

                <ScrollViewer Grid.Row="0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="24,64,24,8"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Name="dailyQuoteText"
                                   Text="加载中…"
                                   FontSize="34"
                                   LineHeight="48"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Name="dailyQuoteFrom"
                                   Text=""
                                   FontSize="20"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Right"
                                   Margin="0,18,0,0"
                                   Opacity="0.75"/>
                    </StackPanel>
                </ScrollViewer>

                <AppBarButton Name="settings"
                              Icon="Setting"
                              IsCompact="True"
                              Height="50"
                              Width="30"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Grid.Row="1"
                              Click="settings_Click"/>
            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>
