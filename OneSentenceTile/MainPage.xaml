<Page
    x:Class="OneSentenceTile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneSentenceTile"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8F98"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5C626B"/>
            <Setter Property="Margin" Value="2,6,0,2"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Page.Resources>

    <SplitView Name="mainSplitView" DisplayMode="Overlay" OpenPaneLength="340">
        <SplitView.Pane>
            <ScrollViewer Background="#F4F5F7">
                <StackPanel Margin="10,12,10,28">

                    <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,8"/>

                    <!-- 磁贴 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="磁贴" Style="{StaticResource SectionTitle}"/>

                            <ToggleSwitch Name="isTileFresh"
                                          OffContent="动态磁贴：关"
                                          OnContent="动态磁贴：开"
                                          Margin="0,-2"
                                          Toggled="isTileFresh_Toggled"/>

                            <TextBlock Text="刷新间隔" Style="{StaticResource Label}"/>
                            <ComboBox Name="tileIntervalCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileIntervalCombo_SelectionChanged">
                                <ComboBoxItem Content="实时（打开就刷新）" Tag="Realtime"/>
                                <ComboBoxItem Content="15 分钟" Tag="QuarterHour"/>
                                <ComboBoxItem Content="30 分钟" Tag="HalfHour"/>
                                <ComboBoxItem Content="1 小时" Tag="Hour"/>
                                <ComboBoxItem Content="6 小时" Tag="SixHours"/>
                                <ComboBoxItem Content="12 小时" Tag="TwelveHours"/>
                                <ComboBoxItem Content="24 小时" Tag="Daily"/>
                            </ComboBox>

                            <Button Name="refreshTileButton" Content="立即刷新磁贴" Margin="0,6,0,0" Click="refreshTileButton_Click"/>

                            <TextBlock Text="磁贴源" Style="{StaticResource Label}"/>
                            <ComboBox Name="tileSourceCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileSourceCombo_SelectionChanged">
                                <ComboBoxItem Content="官方一言（v1.hitokoto.cn）" Tag="hitokoto"/>
                                <ComboBoxItem Content="Worker 实时源（workers.dev）" Tag="worker"/>
                                <ComboBoxItem Content="Pages 快照源（github.io）" Tag="pages"/>
                            </ComboBox>

                            <!-- 只显示实际用的源，比如「磁贴源：官方一言」 -->
                            <TextBlock Name="tileStatusText"
                                       Text="磁贴源：未探测"
                                       FontSize="12"
                                       Foreground="#8A8F98"
                                       TextWrapping="Wrap"
                                       Margin="2,6,0,0"/>

                            <TextBlock Text="一言分类" Style="{StaticResource Label}"/>
                            <ComboBox Name="hitokotoTypeCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="hitokotoTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="随机" Tag=""/>
                                <ComboBoxItem Content="动画" Tag="a"/>
                                <ComboBoxItem Content="漫画" Tag="b"/>
                                <ComboBoxItem Content="游戏" Tag="c"/>
                                <ComboBoxItem Content="文学" Tag="d"/>
                                <ComboBoxItem Content="原创" Tag="e"/>
                                <ComboBoxItem Content="来自网络" Tag="f"/>
                                <ComboBoxItem Content="其他" Tag="g"/>
                                <ComboBoxItem Content="影视" Tag="h"/>
                                <ComboBoxItem Content="诗词" Tag="i"/>
                                <ComboBoxItem Content="网易云" Tag="j"/>
                                <ComboBoxItem Content="哲学" Tag="k"/>
                                <ComboBoxItem Content="抖机灵" Tag="l"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 磁贴文字 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="磁贴文字" Style="{StaticResource SectionTitle}"/>

                            <ToggleSwitch Name="tileShowTitleSwitch" OffContent="显示标题：关" OnContent="显示标题：开"
                                          Margin="0,-2" Toggled="tileShowTitleSwitch_Toggled"/>
                            <ToggleSwitch Name="tileShowAttrSwitch" OffContent="显示出处：关" OnContent="显示出处：开"
                                          Margin="0,-2" Toggled="tileShowAttrSwitch_Toggled"/>

                            <TextBlock Text="标题字号" Style="{StaticResource Label}"/>
                            <ComboBox Name="tileTitleStyleCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileTitleStyleCombo_SelectionChanged"></ComboBox>

                            <TextBlock Text="正文字号" Style="{StaticResource Label}"/>
                            <ComboBox Name="tileQuoteStyleCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileQuoteStyleCombo_SelectionChanged"></ComboBox>

                            <TextBlock Text="出处字号" Style="{StaticResource Label}"/>
                            <ComboBox Name="tileAttrStyleCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileAttrStyleCombo_SelectionChanged"></ComboBox>

                            <TextBlock Text="对齐" Style="{StaticResource Label}"/>
                            <ComboBox Name="tileTitleAlignCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileTitleAlignCombo_SelectionChanged">
                                <ComboBoxItem Content="标题：靠左" Tag="left"/>
                                <ComboBoxItem Content="标题：居中" Tag="center"/>
                                <ComboBoxItem Content="标题：靠右" Tag="right"/>
                            </ComboBox>
                            <ComboBox Name="tileAttrAlignCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="tileAttrAlignCombo_SelectionChanged">
                                <ComboBoxItem Content="出处：靠左" Tag="left"/>
                                <ComboBoxItem Content="出处：居中" Tag="center"/>
                                <ComboBoxItem Content="出处：靠右" Tag="right"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 界面文字 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="界面文字" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="字体" Style="{StaticResource Label}"/>
                            <ComboBox Name="uiFontCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="uiFontCombo_SelectionChanged">
                                <ComboBoxItem Content="系统默认" Tag=""/>
                                <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei UI"/>
                                <ComboBoxItem Content="等线" Tag="DengXian"/>
                                <ComboBoxItem Content="宋体" Tag="SimSun"/>
                                <ComboBoxItem Content="楷体" Tag="KaiTi"/>
                                <ComboBoxItem Content="黑体" Tag="SimHei"/>
                                <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                <ComboBoxItem Content="自定义（见下方输入）" Tag="custom"/>
                            </ComboBox>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="customFontBox" PlaceholderText="字体名，如 思源黑体" FontSize="13"/>
                                <Button Grid.Column="1" Content="应用" Margin="6,0,0,0" Click="applyCustomFontButton_Click"/>
                            </Grid>
                            <Button Name="pickFontButton" Content="从系统字体里选…" Margin="0,6,0,0" Click="pickFontButton_Click"/>

                            <TextBlock Text="标题字号 / 粗细" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Name="uiTitleSizeCombo" Width="110" SelectionChanged="uiTitleSizeCombo_SelectionChanged"></ComboBox>
                                <ToggleSwitch Name="uiTitleBold" Margin="10,-2,0,0" OnContent="加粗" OffContent="常规"
                                              Toggled="uiTitleBold_Toggled"/>
                            </StackPanel>

                            <TextBlock Text="正文字号 / 粗细" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Name="uiQuoteSizeCombo" Width="110" SelectionChanged="uiQuoteSizeCombo_SelectionChanged"></ComboBox>
                                <ToggleSwitch Name="uiQuoteBold" Margin="10,-2,0,0" OnContent="加粗" OffContent="常规"
                                              Toggled="uiQuoteBold_Toggled"/>
                            </StackPanel>

                            <TextBlock Text="出处字号 / 粗细" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Name="uiFromSizeCombo" Width="110" SelectionChanged="uiFromSizeCombo_SelectionChanged"></ComboBox>
                                <ToggleSwitch Name="uiFromBold" Margin="10,-2,0,0" OnContent="加粗" OffContent="常规"
                                              Toggled="uiFromBold_Toggled"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 壁纸 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="壁纸" Style="{StaticResource SectionTitle}"/>
                            <ComboBox Name="wallpaperModeCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="wallpaperModeCombo_SelectionChanged">
                                <ComboBoxItem Content="关闭（纯色/亚克力）" Tag="none"/>
                                <ComboBoxItem Content="本地图片" Tag="file"/>
                                <ComboBoxItem Content="网络地址" Tag="url"/>
                                <ComboBoxItem Content="文件夹循环" Tag="folder"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Name="pickImageButton" Content="选择图片" Margin="0,0,8,0" Click="pickImageButton_Click"/>
                                <Button Name="pickFolderButton" Content="选择文件夹" Click="pickFolderButton_Click"/>
                            </StackPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="wallpaperUrlBox" PlaceholderText="https://…/wallpaper.jpg" FontSize="13"/>
                                <Button Grid.Column="1" Content="应用" Margin="6,0,0,0" Click="applyWallpaperUrlButton_Click"/>
                            </Grid>

                            <TextBlock Text="轮播间隔" Style="{StaticResource Label}"/>
                            <ComboBox Name="wallpaperIntervalCombo" Style="{StaticResource Combo}"
                                      SelectionChanged="wallpaperIntervalCombo_SelectionChanged">
                                <ComboBoxItem Content="1 分钟" Tag="1"/>
                                <ComboBoxItem Content="5 分钟" Tag="5"/>
                                <ComboBoxItem Content="10 分钟" Tag="10"/>
                                <ComboBoxItem Content="30 分钟" Tag="30"/>
                                <ComboBoxItem Content="60 分钟" Tag="60"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 窗口与颜色 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="窗口与颜色" Style="{StaticResource SectionTitle}"/>

                            <ToggleSwitch Name="isDisplayRequest" OffContent="屏幕常亮：关" OnContent="屏幕常亮：开"
                                          Margin="0,-2" Toggled="isDisplayRequest_Toggled"/>
                            <ToggleSwitch Name="isfullScreen" OffContent="全屏：关" OnContent="全屏：开"
                                          Margin="0,-2" Toggled="isfullScreen_Toggled"/>

                            <TextBlock Text="背景色" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="红" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Name="BackGroundColorRedSlider" Grid.Column="1" Maximum="255" ValueChanged="BackGroundColorRedSlider_ValueChanged"/>
                                <TextBlock Text="绿" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Row="1"/>
                                <Slider Name="BackGroundColorGreenSlider" Grid.Column="1" Grid.Row="1" Maximum="255" ValueChanged="BackGroundColorGreenSlider_ValueChanged"/>
                                <TextBlock Text="蓝" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Row="2"/>
                                <Slider Name="BackGroundColorBlueSlider" Grid.Column="1" Grid.Row="2" Maximum="255" ValueChanged="BackGroundColorBlueSlider_ValueChanged"/>
                                <TextBlock Text="透" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Row="3"/>
                                <Slider Name="BackGroundAcrylicBlueSlider" Grid.Column="1" Grid.Row="3" Maximum="100" Value="10" ValueChanged="BackGroundAcrylicBlueSlider_ValueChanged"/>
                            </Grid>

                            <TextBlock Text="字体色" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="红" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Name="FontColorRedSlider" Grid.Column="1" Maximum="255" ValueChanged="FontColorRedSlider_ValueChanged"/>
                                <TextBlock Text="绿" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Row="1"/>
                                <Slider Name="FontColorGreenSlider" Grid.Column="1" Grid.Row="1" Maximum="255" ValueChanged="FontColorGreenSlider_ValueChanged"/>
                                <TextBlock Text="蓝" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Row="2"/>
                                <Slider Name="FontColorBlueSlider" Grid.Column="1" Grid.Row="2" Maximum="255" ValueChanged="FontColorBlueSlider_ValueChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="https://github.com/bzhcyy/OneSentenceTile"
                               IsTextSelectionEnabled="True"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="4,2,4,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid Name="mainGrid">
                <Image Name="wallImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Visibility="Collapsed"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="headerText"
                               Text="每日一言："
                               Grid.Row="0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,22,0,0"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  Margin="32,24,32,16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Name="dailyQuoteText"
                                       Text="加载中…"
                                       FontSize="36"
                                       LineHeight="50"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <TextBlock Name="dailyQuoteFrom"
                                       Text=""
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       Margin="0,18,0,0"
                                       Opacity="0.75"/>
                        </StackPanel>
                    </ScrollViewer>

                    <AppBarButton Name="settings"
                                  Icon="Setting"
                                  IsCompact="True"
                                  Height="44"
                                  Width="44"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Grid.Row="2"
                                  Margin="6,0,0,6"
                                  Click="settings_Click"/>
                </Grid>
            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>
