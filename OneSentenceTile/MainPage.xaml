<Page
    x:Class="OneSentenceTile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneSentenceTile"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <SplitView Name="mainSplitView" DisplayMode="Overlay" OpenPaneLength="340">
        <SplitView.Pane>
            <ScrollViewer Background="#F2F4F6">
                <StackPanel Orientation="Vertical" Padding="0,8,0,24">
                    <TextBlock Text="设置" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="5,4,5,10"/>

                    <!-- 磁贴 -->
                    <TextBlock Text="磁贴" FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,6,0,0"/>
                    <ToggleSwitch Name="isTileFresh"
                                  OffContent="动态磁贴已关闭"
                                  OnContent="动态磁贴已开启"
                                  Margin="5,0,5,0"
                                  Toggled="isTileFresh_Toggled"/>

                    <TextBlock Text="刷新间隔：" FontSize="14" Margin="12,2,0,0"/>
                    <ComboBox Name="tileIntervalCombo"
                              Margin="8,0,8,6"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="tileIntervalCombo_SelectionChanged">
                        <ComboBoxItem Content="实时（立即刷新）" Tag="Realtime"/>
                        <ComboBoxItem Content="30 分钟" Tag="HalfHour"/>
                        <ComboBoxItem Content="1 小时" Tag="Hour"/>
                        <ComboBoxItem Content="6 小时" Tag="SixHours"/>
                        <ComboBoxItem Content="12 小时" Tag="TwelveHours"/>
                        <ComboBoxItem Content="24 小时" Tag="Daily"/>
                    </ComboBox>

                    <ToggleSwitch Name="isWorkerFirst"
                                  OffContent="磁贴源：Pages 优先"
                                  OnContent="磁贴源：Worker 优先"
                                  Margin="5,0,5,0"
                                  Toggled="isWorkerFirst_Toggled"/>

                    <TextBlock Text="一言分类：" FontSize="14" Margin="12,2,0,0"/>
                    <ComboBox Name="hitokotoTypeCombo"
                              Margin="8,0,8,6"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="hitokotoTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="随机" Tag=""/>
                        <ComboBoxItem Content="动画" Tag="a"/>
                        <ComboBoxItem Content="漫画" Tag="b"/>
                        <ComboBoxItem Content="游戏" Tag="c"/>
                        <ComboBoxItem Content="文学" Tag="d"/>
                        <ComboBoxItem Content="原创" Tag="e"/>
                        <ComboBoxItem Content="来自网络" Tag="f"/>
                        <ComboBoxItem Content="其他" Tag="g"/>
                        <ComboBoxItem Content="影视" Tag="h"/>
                        <ComboBoxItem Content="诗词" Tag="i"/>
                        <ComboBoxItem Content="网易云" Tag="j"/>
                        <ComboBoxItem Content="哲学" Tag="k"/>
                        <ComboBoxItem Content="抖机灵" Tag="l"/>
                    </ComboBox>


                    <TextBlock Text="磁贴文字" FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,10,0,0"/>

                    <TextBlock Text="标题大小：" FontSize="14" Margin="12,2,0,0"/>
                    <ComboBox Name="tileTitleStyleCombo" Margin="8,0,8,4" HorizontalAlignment="Stretch" SelectionChanged="tileTitleStyleCombo_SelectionChanged">
                        <ComboBoxItem Content="极小 12" Tag="caption"/>
                        <ComboBoxItem Content="小 15" Tag="base"/>
                        <ComboBoxItem Content="中 20" Tag="subtitle"/>
                        <ComboBoxItem Content="大 24" Tag="title"/>
                        <ComboBoxItem Content="特大 34" Tag="subheader"/>
                        <ComboBoxItem Content="巨大 46" Tag="header"/>
                        <ComboBoxItem Content="小·淡 15" Tag="baseSubtle"/>
                        <ComboBoxItem Content="极小·淡 12" Tag="captionSubtle"/>
                    </ComboBox>

                    <TextBlock Text="正文大小：" FontSize="14" Margin="12,2,0,0"/>
                    <ComboBox Name="tileQuoteStyleCombo" Margin="8,0,8,4" HorizontalAlignment="Stretch" SelectionChanged="tileQuoteStyleCombo_SelectionChanged">
                        <ComboBoxItem Content="极小 12" Tag="caption"/>
                        <ComboBoxItem Content="小 15" Tag="base"/>
                        <ComboBoxItem Content="中 20" Tag="subtitle"/>
                        <ComboBoxItem Content="大 24" Tag="title"/>
                        <ComboBoxItem Content="特大 34" Tag="subheader"/>
                        <ComboBoxItem Content="巨大 46" Tag="header"/>
                        <ComboBoxItem Content="小·淡 15" Tag="baseSubtle"/>
                        <ComboBoxItem Content="极小·淡 12" Tag="captionSubtle"/>
                    </ComboBox>

                    <TextBlock Text="出处大小：" FontSize="14" Margin="12,2,0,0"/>
                    <ComboBox Name="tileAttrStyleCombo" Margin="8,0,8,6" HorizontalAlignment="Stretch" SelectionChanged="tileAttrStyleCombo_SelectionChanged">
                        <ComboBoxItem Content="极小 12" Tag="caption"/>
                        <ComboBoxItem Content="小 15" Tag="base"/>
                        <ComboBoxItem Content="中 20" Tag="subtitle"/>
                        <ComboBoxItem Content="大 24" Tag="title"/>
                        <ComboBoxItem Content="特大 34" Tag="subheader"/>
                        <ComboBoxItem Content="巨大 46" Tag="header"/>
                        <ComboBoxItem Content="小·淡 15" Tag="baseSubtle"/>
                        <ComboBoxItem Content="极小·淡 12" Tag="captionSubtle"/>
                    </ComboBox>

                    <TextBlock Text="界面字体：" FontSize="14" Margin="12,4,0,0"/>
                    <ComboBox Name="uiFontCombo" Margin="8,0,8,6" HorizontalAlignment="Stretch" SelectionChanged="uiFontCombo_SelectionChanged">
                        <ComboBoxItem Content="系统默认" Tag=""/>
                        <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei UI"/>
                        <ComboBoxItem Content="等线" Tag="DengXian"/>
                        <ComboBoxItem Content="宋体" Tag="SimSun"/>
                        <ComboBoxItem Content="楷体" Tag="KaiTi"/>
                        <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                    </ComboBox>

                    <!-- 窗口 -->
                    <TextBlock Text="窗口" FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,10,0,0"/>
                    <ToggleSwitch Name="isDisplayRequest"
                                  OffContent="屏幕常亮已关闭"
                                  OnContent="屏幕常亮已开启"
                                  Margin="5,0,5,0"
                                  Toggled="isDisplayRequest_Toggled"/>
                    <ToggleSwitch Name="isfullScreen"
                                  OffContent="全屏已关闭"
                                  OnContent="全屏已开启"
                                  Margin="5,0,5,0"
                                  Toggled="isfullScreen_Toggled"/>

                    <!-- 壁纸 -->
                    <TextBlock Text="壁纸" FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,10,0,0"/>
                    <ComboBox Name="wallpaperModeCombo"
                              Margin="8,0,8,4"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="wallpaperModeCombo_SelectionChanged">
                        <ComboBoxItem Content="关闭（纯色/亚克力）" Tag="none"/>
                        <ComboBoxItem Content="本地图片" Tag="file"/>
                        <ComboBoxItem Content="网络地址" Tag="url"/>
                        <ComboBoxItem Content="文件夹循环" Tag="folder"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="8,0,8,4">
                        <Button Name="pickImageButton" Content="选择图片" Margin="0,0,8,0" Click="pickImageButton_Click"/>
                        <Button Name="pickFolderButton" Content="选择文件夹" Click="pickFolderButton_Click"/>
                    </StackPanel>

                    <Grid Margin="8,0,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="wallpaperUrlBox" PlaceholderText="https://…/wallpaper.jpg" FontSize="13"/>
                        <Button Grid.Column="1" Content="应用" Margin="6,0,0,0" Click="applyWallpaperUrlButton_Click"/>
                    </Grid>

                    <TextBlock Text="轮播间隔：" FontSize="14" Margin="12,2,0,0"/>
                    <ComboBox Name="wallpaperIntervalCombo"
                              Margin="8,0,8,6"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="wallpaperIntervalCombo_SelectionChanged">
                        <ComboBoxItem Content="1 分钟" Tag="1"/>
                        <ComboBoxItem Content="5 分钟" Tag="5"/>
                        <ComboBoxItem Content="10 分钟" Tag="10"/>
                        <ComboBoxItem Content="30 分钟" Tag="30"/>
                        <ComboBoxItem Content="60 分钟" Tag="60"/>
                    </ComboBox>

                    <!-- 颜色 -->
                    <TextBlock Text="背景颜色" FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,10,0,0"/>
                    <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="红" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <Slider Name="BackGroundColorRedSlider" Grid.Column="1" Maximum="255" ValueChanged="BackGroundColorRedSlider_ValueChanged"/>
                        <TextBlock Text="绿" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center" Grid.Row="1"/>
                        <Slider Name="BackGroundColorGreenSlider" Grid.Column="1" Grid.Row="1" Maximum="255" ValueChanged="BackGroundColorGreenSlider_ValueChanged"/>
                        <TextBlock Text="蓝" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center" Grid.Row="2"/>
                        <Slider Name="BackGroundColorBlueSlider" Grid.Column="1" Grid.Row="2" Maximum="255" ValueChanged="BackGroundColorBlueSlider_ValueChanged"/>
                        <TextBlock Text="透" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center" Grid.Row="3"/>
                        <Slider Name="BackGroundAcrylicBlueSlider" Grid.Column="1" Grid.Row="3" Maximum="100" Value="10" ValueChanged="BackGroundAcrylicBlueSlider_ValueChanged"/>
                    </Grid>

                    <TextBlock Text="字体颜色" FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,8,0,0"/>
                    <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="红" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center"/>
                        <Slider Name="FontColorRedSlider" Grid.Column="1" Maximum="255" ValueChanged="FontColorRedSlider_ValueChanged"/>
                        <TextBlock Text="绿" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center" Grid.Row="1"/>
                        <Slider Name="FontColorGreenSlider" Grid.Column="1" Grid.Row="1" Maximum="255" ValueChanged="FontColorGreenSlider_ValueChanged"/>
                        <TextBlock Text="蓝" FontSize="14" Margin="4,0,6,0" VerticalAlignment="Center" Grid.Row="2"/>
                        <Slider Name="FontColorBlueSlider" Grid.Column="1" Grid.Row="2" Maximum="255" ValueChanged="FontColorBlueSlider_ValueChanged"/>
                    </Grid>

                    <TextBlock Text="本项目"
                               FontSize="16" FontWeight="SemiBold" Foreground="#666" Margin="12,12,0,0"/>
                    <TextBlock Text="https://github.com/bzhcyy/OneSentenceTile"
                               IsTextSelectionEnabled="True"
                               FontSize="13"
                               Margin="12,2,12,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid Name="mainGrid">
                <Image Name="wallImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Visibility="Collapsed"/>

                <Rectangle Name="wallScrim" Fill="#33000000" Visibility="Collapsed"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="headerText"
                               Text="每日一言"
                               Grid.Row="0"
                               HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,22,0,0"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  Margin="32,24,32,16"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Name="dailyQuoteText"
                                       Text="加载中…"
                                       FontSize="36"
                                       LineHeight="50"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <TextBlock Name="dailyQuoteFrom"
                                       Text=""
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Right"
                                       Margin="0,18,0,0"
                                       Opacity="0.75"/>
                        </StackPanel>
                    </ScrollViewer>

                    <AppBarButton Name="settings"
                                  Icon="Setting"
                                  IsCompact="True"
                                  Height="44"
                                  Width="44"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Grid.Row="2"
                                  Margin="6,0,0,6"
                                  Click="settings_Click"/>
                </Grid>
            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>
